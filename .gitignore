# macOS
.DS_Store
**/.DS_Store

# Runtime artifacts (generated by watcher at runtime)
.bridge/bridge.log
.bridge/heartbeat.json

# Node
node_modules/
*.log
npm-debug.log*
yarn-debug.log*

# Queue runtime state (managed by watcher, not source code)
bridge/queue/*.md
bridge/queue/*.json
!bridge/queue/.gitkeep

# Error JSON records (written by watcher at runtime)
bridge/errors/*.json
!bridge/errors/.gitkeep

# Register log — append-only runtime file, not source code
bridge/register.jsonl

# Environment
.env
.env.*
!.env.example
bridge/nog-active.json
bridge/wormhole-heartbeat.json

# Nog review logs (runtime, not source)
bridge/logs/

# Worktree rescue artifacts (created at runtime on no_report failures)
bridge/worktree-rescue/

# Experiment sandboxes
experiments/*/node_modules/

# RESTAGED bootstrap marker — written once per install, workspace-local
bridge/.restaged-bootstrap-done

# Main-lock state marker — transient, written by unlock-main.sh, removed by lock-main.sh
bridge/.main-unlocked

# runtime debris from test/regression-*.test.js (retired-gate tests) — a committed hang.test.js would freeze CI + the promote gate
regression/_test_timeout_suite/
regression/_test_pass_suite/

# Bashir's generated regression report + the auto-routed O'Brien handoff (regenerated every gate run)
regression/LAST-RUN.md
.claude/roles/obrien/inbox/REGRESSION-FAILURE.md

# Playwright e2e artifacts (generated)
node_modules/
test-results/
playwright-report/
blob-report/
.playwright/
regression/TESTS-NEEDED.json

# AC-reconcile generated outputs (the manifest lock IS tracked; these regenerate)
regression/AC-RECONCILE.json
.claude/roles/bashir/inbox/RECONCILE-NEEDED.md
