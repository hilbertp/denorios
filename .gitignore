# macOS
.DS_Store
**/.DS_Store

# Runtime artifacts (generated by watcher at runtime)
.bridge/bridge.log
.bridge/heartbeat.json

# Node
# NO TRAILING SLASH, deliberately (slice 376). Every slice/review workspace is a git
# worktree whose node_modules is a SYMLINK to the main checkout's. `node_modules/`
# means "directory only" and does not match a symlink, so with the slash the link
# shows up as untracked and the first `git add -A` commits it.
node_modules
*.log
npm-debug.log*
yarn-debug.log*

# Queue runtime state (managed by watcher, not source code)
bridge/queue/*.md
bridge/queue/*.json
!bridge/queue/.gitkeep

# Error JSON records (written by watcher at runtime)
bridge/errors/*.json
!bridge/errors/.gitkeep

# Register log — append-only runtime file, not source code
bridge/register.jsonl

# Volatile runtime state (slice 372) — heartbeat ticks, queue ordering, branch
# topology, timesheets and trash bookkeeping. These are rewritten continuously by
# the running system. While they were tracked the working tree was never clean, so
# the orchestrator's pre-checkout autocommit swept machine bookkeeping into a
# commit on the integration branch on every slice run (23 such commits landed
# before this was ignored). Nothing in git recreates them on a fresh clone —
# bridge/state/seed-runtime-state.js seeds them at startup instead.
bridge/heartbeat.json
bridge/queue-order.json
bridge/state/branch-state.json
bridge/timesheet.jsonl
bridge/timesheet-watcher.jsonl
bridge/anchors.jsonl
bridge/anchors-watcher.jsonl
bridge/tt-audit.jsonl
bridge/tt-audit-watcher.jsonl
bridge/.usage-snapshot.json

# Trash — where the pipeline sweeps finished queue files and runtime markers.
# Ignored wholesale like bridge/queue/; archived slice reports that are worth
# keeping are force-added as permanent records, exactly as queue reports are.
bridge/trash/*
!bridge/trash/.gitkeep

# Environment
.env
.env.*
!.env.example
bridge/nog-active.json
bridge/wormhole-heartbeat.json

# Nog review logs (runtime, not source)
bridge/logs/

# Worktree rescue artifacts (created at runtime on no_report failures)
bridge/worktree-rescue/

# Experiment sandboxes
experiments/*/node_modules/

# RESTAGED bootstrap marker — written once per install, workspace-local
bridge/.restaged-bootstrap-done

# Main-lock state marker — transient, written by unlock-main.sh, removed by lock-main.sh
bridge/.main-unlocked

# runtime debris from test/regression-*.test.js (retired-gate tests) — a committed hang.test.js would freeze CI + the promote gate
regression/_test_timeout_suite/
regression/_test_pass_suite/

# Bashir's generated regression report + the auto-routed O'Brien handoff (regenerated every gate run)
regression/LAST-RUN.md
.claude/roles/obrien/inbox/REGRESSION-FAILURE.md

# Playwright e2e artifacts (generated)
node_modules
test-results/
playwright-report/
blob-report/
.playwright/
regression/TESTS-NEEDED.json

# AC-reconcile generated outputs (the manifest lock IS tracked; these regenerate)
regression/AC-RECONCILE.json
.claude/roles/bashir/inbox/RECONCILE-NEEDED.md
.claude/roles/bashir/inbox/NEW-ACS.md

# Test-authoring drafts (proposals for human review, not committed)
regression/.drafts/
