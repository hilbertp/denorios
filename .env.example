# Liberation of Bajor — environment template.
# Copy to .env (gitignored). The orchestrator launchd job loads .env via --env-file.
# See docs/runbooks/RUNBOOK-PUSH-AND-MERGE.md and RUNBOOK-CLAUDE-AUTH.md.

# --- Auth: REQUIRED for headless `claude -p` (Bashir, Rom, Nog) ---
# An OAuth token from `claude setup-token` — NOT an Anthropic API key.
# (The orchestrator and gate spawn `claude -p`, which reads this from the env.)
CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token-here

# --- Merge strategy flag ---
# 0 = legacy: ACCEPTED slices merge directly to main
# 1 = gate flow: ACCEPTED slices squash to dev; Bashir regression-gates dev -> main
DS9_USE_GATE_FLOW=1

# --- Regression suite timeout, seconds (optional; default 600) ---
# DS9_REGRESSION_TIMEOUT_S=600

# --- DS9_WATCHER_MERGE — do NOT set this here. ---
# It is a per-COMMAND flag (DS9_WATCHER_MERGE=1 git commit ...) used ONLY by the
# merge path / manual merge ops to bypass the main-working-tree pre-commit hook.
# Setting it permanently in .env would defeat that commit protection for every
# process that loads .env. See RUNBOOK-PUSH-AND-MERGE.md §3.
